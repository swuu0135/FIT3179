{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Great Barrier Reef Visits",
    "width": 450,
    "height": 300,
    "padding": {
        "left": 30,
        "right": 57
    },
   
    "data": {
        "url": "3_line_chart/GBRMP Visitations-All.csv"
    },
    "transform": [
        {
            "calculate": "datum.Quarter == 'Q1' ? datum.Year + '-01-01' : datum.Quarter == 'Q2' ? datum.Year + '-04-01' : datum.Quarter == 'Q3' ? datum.Year + '-07-01' : datum.Year + '-10-01'",
            "as": "Timeline"
        },
        {
            "calculate": "toDate(datum.Timeline)",
            "as": "TimelineDate"
        }
    ],
    "mark": {
        "type": "line",
        "point": true
    },
    "encoding": {
        "x": {
            "field": "TimelineDate",
            "type": "temporal",
            "sort": "ascending",
            "axis": {
                "format": "%d/%m/%Y",
                "title": "Date"
            }
        },
        "y": {
            "field": "Total Visits",
            "type": "quantitative"
        },
        "tooltip": [
            {
                "field": "TimelineDate",
                "type": "temporal",
                "format": "%d/%m/%Y",
                "title": "Date"
            },
            {
                "field": "Total Visits",
                "type": "quantitative"
            }
        ]
    }
}