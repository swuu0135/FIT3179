{
    "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
    "title": "Tourism shares",
    "width": 400,
    "height": 365,
    "padding": {
        "left": 50, 
        "right": 70,
        "top": 10,
        "bottom": 15
    },
    
    "data": {
        "url": "8_lollipop_chart/tourism_state_shares.csv"
    },
    "encoding": {
        "x": {
            "field": "Tourism_Share_Percent",
            "type": "quantitative",
            "title": "Contribution Share"
        },
        "y": {
            "field": "State",
            "type": "nominal"
        }
    },
    "layer": [
        {
            "mark": {
                "type": "rule",
                "color": "#cbd5e1",
                "size": 2
            }
        },
        {
            "mark": {
                "type": "circle",
                "size": 180,
                "color": "#0ea5e9"
            },
            "encoding": {
                "tooltip": [
                    {
                        "field": "State",
                        "type": "nominal"
                    },
                    {
                        "field": "Tourism_Share_Percent",
                        "type": "quantitative",
                        "title": "Tourism Share (%)"
                    }
                ],
                "color": {
                    "field": "State",
                    "type": "nominal",
                    "legend": null
                }
            }
        }
    ]
}