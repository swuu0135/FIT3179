{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "width": 800,
  "height": 450,
  "title": "Number of Visits to Australian Parks 2024-25",
  "projection": {"type": "mercator"},
  "layer": [
    {
      "data": {
        "url": "7_proportional_symbol_map/ne_10m_admin_1_states_provinces.json",
        "format": {"type": "topojson", "feature": "australia_states"}
      },
      "mark": {"type": "geoshape", "fill": "gray", "stroke": "white"}
    },
    {
      "data": {
        "url": "7_proportional_symbol_map/year_visits_2024-25.csv"
      },
      "mark": {"type": "circle", "tooltip": {"content": "data"}},
      "encoding": {
        "longitude": {"field": "longitude", "type": "quantitative"},
        "latitude": {"field": "latitude", "type": "quantitative"},
        "size": {
          "field": "Visits",
          "type": "quantitative"
        },
        "color": {
          "field": "Park",
          "type": "nominal"
        }
      }
    }
  ]
}