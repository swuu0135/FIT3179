{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Number of Birds Sightings by State",
  "width": 410,
  "height": 450,
  "padding":{
    "left": 70, 
    "right": 30
  },
  "projection": {
    "type": "mercator",
    "scale": 500,
    "center": [
      133,
      -27
    ]
  },
  "layer": [
    {
      "data": {
        "url": "12_symbol_map/ne_10m_admin_1_states_provinces.json",
        "format": {
          "type": "topojson",
          "feature": "australia_states"
        }
      },
      "mark": {
        "type": "geoshape",
        "fill": "gray",
        "stroke": "white"
      }
    },
    {
      "data": {
        "url": "12_symbol_map/birds_by_state.csv"
      },
      "mark": {
        "type": "circle",
        "tooltip": {
          "content": "data"
        }
      },
      "encoding": {
        "longitude": {
          "field": "longitude",
          "type": "quantitative"
        },
        "latitude": {
          "field": "latitude",
          "type": "quantitative"
        },
        "size": {
          "field": "Count",
          "type": "quantitative",
          "scale": {
            "type": "threshold",
            "domain": [2383514, 4343707],
            "range": [100, 300, 600]
          },
          "legend": {
            "title": "Number of Sightings"
          }
        },
        "color": {
          "field": "stateProvince",
          "type": "nominal",
          "legend": {
            "orient": "bottom-left",
            "labelLimit": 300, 
            "title": "States"
          }
        }
      }
    }
    
  ]
}