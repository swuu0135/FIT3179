{
  "$schema": "https://vega.github.io/schema/vega-lite/v6.json",
  "title": "Australia Coral Coast Tourism Consumption (2023-24)",
  "width": 300,
  "height": 300,
  "data": {
    "url": "10_bar_chart/coral_coast_tourism_consumption.csv"
  },
  "mark": "bar",
  "encoding": {
    "x": {
      "field": "Value",
      "type": "quantitative",
      "axis": {
        "title": "Tourism Consumption ($M)"
      }
    },
    "y": {
      "field": "Tourism products",
      "type": "nominal",
      "sort": "-x",
      "axis": {
        "labelLimit": 300
      }
    },
    "tooltip": [
      {
        "field": "Tourism products",
        "type": "nominal",
        "title": "Tourism products"
      },
      {
        "field": "Value",
        "type": "quantitative",
        "title": "Tourism Consumption($M)",
        "format": ","
      }
    ]
  }
}